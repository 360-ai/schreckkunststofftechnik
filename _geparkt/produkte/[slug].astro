---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import { products, company } from "@data/site";

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const canonicalUrl = new URL(`/produkte/${product.slug}/`, Astro.site).toString();
const metaDescriptions: Record<string, string> = {
  medizintechnik: "Spritzgusswerkzeuge für medizinische Kunststoffteile wie Einmalspritzen, Schutzkappen, Verbindungselemente, Kleinstteile und Filtertechnik.",
  innenanspritzung: "Werkzeugkonzepte für Innenanspritzung in der Verschlusstechnik – mit Fokus auf Oberflächengüte, Maßqualität und balancierte Fließwege."
};
const metaDescription = metaDescriptions[product.slug] ?? product.intro;
const inquiryItems = [
  "Zeichnung, Muster oder vorhandene CAD-Daten",
  "Bauteilfunktion und Einsatzbereich",
  "vorgesehener Werkstoff und Zielstückzahl, soweit bekannt",
  "Maße, Toleranzen, Oberflächen- und Prüfanforderungen",
  "geplanter Serienstart und gewünschte Dokumentation"
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${canonicalUrl}#service`,
  name: `${product.title} - ${company.name}`,
  provider: { "@id": new URL("/#organization", Astro.site).toString() },
  areaServed: [{ "@type": "Country", name: "Deutschland" }, { "@type": "State", name: company.region }],
  serviceType: product.keywords.join(", "),
  description: product.intro,
  audience: { "@type": "BusinessAudience", audienceType: "B2B-Kunden im Werkzeug- und Formenbau" },
  termsOfService: new URL("/kontakt/", Astro.site).toString()
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Startseite", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Produkte", item: new URL("/produkte/", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: product.title, item: canonicalUrl }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: product.faqs.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } }))
};
---

<BaseLayout
  title={`Spritzgusswerkzeuge: ${product.title}`}
  description={metaDescription}
  canonical={canonicalUrl}
  jsonLd={[schema, breadcrumbSchema, faqSchema]}
>
  <PageHero eyebrow="Produktbereich" title={product.title} text={product.intro} image={product.image} parent={{ label: "Produkte", href: "/produkte/" }} />

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">{product.eyebrow}</p>
        <h2>Anwendung und Formanforderungen gemeinsam betrachten</h2>
        <p class="lead">{product.overview}</p>
      </div>
      <div class="card"><div class="card-body">
        <h3>Dokumentierte Formanforderungen</h3>
        <div class="pill-list">{product.requirements.map((item) => <span class="pill">{item}</span>)}</div>
      </div></div>
    </div>
  </section>

  <section class="section soft">
    <div class="container grid two detail-grid">
      <h2 class="visually-hidden">Anwendungsdetails und Projektweg</h2>
      <article class="card"><div class="card-body">
        <p class="eyebrow">Anwendungen</p>
        <h2>Belegte Bauteile und Einsatzfelder</h2>
        <ul class="feature-list">{product.examples.map((item) => <li>{item}</li>)}</ul>
      </div></article>
      <article class="card"><div class="card-body">
        <p class="eyebrow">Projektweg</p>
        <h2>Bis zur Abmusterung und Serienreife</h2>
        <p>Schreck verbindet Konzeptionierung, Konstruktion, Entwicklung, Abmusterung, Vermessung, Optimierung und Dokumentation. Die hergestellten Formen können auf eigenen Spritzgießmaschinen abgemustert werden.</p>
        <a class="text-link" href="/kompetenzen/">Projektablauf und Kompetenzen ansehen &rarr;</a>
      </div></article>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Projektanfrage</p>
        <h2>Diese Informationen helfen bei der ersten Einordnung</h2>
        <p class="lead">Nicht jede Angabe muss zu Beginn feststehen. Je konkreter Bauteil, Einsatz und Zielprozess beschrieben sind, desto gezielter kann Schreck die Machbarkeit prüfen.</p>
      </div>
      <ul class="inquiry-list">{inquiryItems.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <p class="eyebrow">Häufige Fragen</p>
      <h2>Direkte Antworten zu {product.title}</h2>
      <div class="faq-list">
        {product.faqs.map(({ q, a }) => <details class="faq-item"><summary>{q}</summary><div class="faq-answer">{a}</div></details>)}
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container split">
      <div>
        <p class="eyebrow">Nächster Schritt</p>
        <h2>Werkzeugkonzept für Ihre Anwendung prüfen lassen</h2>
        <p class="lead">Übermitteln Sie Zeichnung, Muster oder vorhandene Projektdaten per E-Mail oder besprechen Sie die Ausgangslage telefonisch.</p>
      </div>
      <div class="button-row">
        <a class="button" href={`mailto:${company.email}?subject=Projektanfrage%20${encodeURIComponent(product.title)}`}>Unterlagen übermitteln</a>
        <a class="button secondary" href="/qualitaet-zertifizierung/">Qualität &amp; Zertifizierung</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .detail-grid h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .text-link { display: inline-block; margin-top: 18px; color: var(--accent-text); font-weight: 800; }
  .inquiry-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 24px 24px 24px 46px;
    border: 1px solid rgba(8, 145, 178, 0.35);
    border-radius: 8px;
    background: rgba(8, 145, 178, 0.12);
    color: var(--primary-deep);
  }
</style>

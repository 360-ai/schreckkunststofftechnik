---
import { company } from '@data/site';
---

<div class="mobile-bar" id="mobile-bar">
  <a href={company.phoneLink}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M4 5c0-1 .8-2 1.9-2h2.3c.9 0 1.6.6 1.9 1.4l.9 2.8c.2.8 0 1.6-.7 2.1l-1.2 1a13.5 13.5 0 0 0 5.6 5.6l1-1.2c.5-.7 1.3-.9 2.1-.7l2.8.9c.8.3 1.4 1 1.4 1.9v2.3c0 1.1-1 1.9-2 1.9C10.6 21 3 13.4 4 5Z" />
    </svg>
    Anrufen
  </a>
  <a href={`mailto:${company.email}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3 7 9 6 9-6" />
    </svg>
    E-Mail
  </a>
  <a href="/#anfrage" class="bar-primary">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M12 5v14M5 12h14" />
    </svg>
    Anfrage
  </a>
</div>

<script>
  // Bar ausblenden, solange ein Eingabefeld fokussiert ist (virtuelle Tastatur, Plan 3.1 Punkt 6).
  const bar = document.getElementById('mobile-bar')!;
  document.addEventListener('focusin', (e) => {
    const t = e.target as HTMLElement;
    if (t.matches('input, textarea, select')) bar.classList.add('bar-hidden');
  });
  document.addEventListener('focusout', () => {
    setTimeout(() => {
      const a = document.activeElement;
      if (!a || !a.matches('input, textarea, select')) bar.classList.remove('bar-hidden');
    }, 50);
  });
</script>

<style>
  .mobile-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    background: var(--surface);
    border-top: 1px solid rgba(38, 142, 166, 0.3);
    padding-bottom: env(safe-area-inset-bottom);
  }
  /* Seite bekommt Platz, damit die Bar nichts überdeckt (Plan 3.1 Punkt 6) */
  :global(body) { padding-bottom: calc(3.5rem + env(safe-area-inset-bottom)); }

  .mobile-bar a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 3.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--petrol-deep);
    text-decoration: none;
  }
  .mobile-bar svg { width: 1.125rem; height: 1.125rem; }
  .bar-primary { background: var(--petrol-deep); color: #fff !important; }
  .bar-hidden { display: none; }

  @media (min-width: 768px) {
    .mobile-bar { display: none; }
    :global(body) { padding-bottom: 0; }
  }
</style>

---
import { productGroups, aiProductNotice } from '@data/site';
---

<section class="section" id="produktgruppen">
  <div class="container">
    <p class="eyebrow">Produkte</p>
    <h2 class="section-heading">Sechs Produktgruppen im Formenbau</h2>
    <p class="section-intro">
      Jede Form entsteht nach Ihren Vorgaben. Die Prospekt-Inhalte finden Sie ausführlich auf der <a href="/produkte/">Produktseite</a> und als PDF.
    </p>

    <ul class="product-grid">
      {
        productGroups.map((group) => (
          <li class="card product-card reveal">
            <a href={`/produkte/#${group.id}`} class="product-link">
              <span class="product-media">
                <img
                  src={group.cardImage.src}
                  alt=""
                  width={group.cardImage.width}
                  height={group.cardImage.height}
                  loading="lazy"
                />
              </span>
              <span class="product-body">
                <span class="product-title">
                  {group.cardTitle}<span class="ai-star" aria-hidden="true">*</span>
                  <span class="visually-hidden">(Produktbeispiel: KI-generierte Abbildung)</span>
                </span>
                <span class="product-text">{group.cardText}</span>
                <span class="product-pills">
                  {group.pills.map((pill) => (
                    <span class="pill">{pill}</span>
                  ))}
                </span>
                <span class="product-more">
                  Mehr zu {group.cardTitle}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="ai-notice-hint">
      {aiProductNotice.homepageHint} <a href="/produkte/#ki-bildhinweis">Mehr dazu</a>.
    </p>
  </div>
</section>

<style>
  .section-intro { color: var(--slate); margin-top: 0.875rem; }
  .section-intro a {
    color: var(--petrol-deep);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .section-intro a:hover { color: var(--ink); }

  .product-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.25rem;
  }
  .ai-notice-hint {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--slate);
  }
  .ai-notice-hint a { color: var(--slate); text-decoration: underline; text-underline-offset: 2px; }
  .ai-notice-hint a:hover { color: var(--petrol-deep); }
  .product-card { overflow: hidden; }
  .product-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .product-media {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--paper);
    border-bottom: 1px solid rgba(38, 142, 166, 0.15);
    overflow: hidden;
  }
  .product-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.75rem;
  }
  .product-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.125rem 1.25rem 1.25rem;
    gap: 0.625rem;
  }
  .product-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ink);
  }
  .product-text { font-size: 0.9375rem; color: var(--slate); }
  .ai-star { color: var(--slate); font-weight: 400; margin-left: 0.05rem; }
  .product-pills { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .product-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.375rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--petrol-deep);
  }
  .product-more svg { width: 1rem; height: 1rem; transition: transform 0.15s ease; }
  .product-link:hover .product-more svg { transform: translateX(3px); }

  @media (min-width: 640px) {
    .product-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .product-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>

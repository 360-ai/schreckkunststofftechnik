---
import { montageService } from '@data/site';
---

<section class="section dark-section montage-section" id="montageservice">
  <div class="container">
    <div class="montage-grid">
      <div class="montage-copy reveal">
        <p class="eyebrow">{montageService.eyebrow}</p>
        <h2 class="section-heading">{montageService.heading}</h2>
        <p class="montage-intro">{montageService.intro}</p>

        <ul class="montage-list">
          {
            montageService.points.map((point) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{point}</span>
              </li>
            ))
          }
        </ul>

        <a href={montageService.cta.href} class="btn btn-primary montage-cta">{montageService.cta.label}</a>
      </div>

      <figure class="montage-media reveal">
        <img src={montageService.image.src} alt={montageService.image.alt} width={montageService.image.width} height={montageService.image.height} loading="lazy" />
      </figure>
    </div>
  </div>
</section>

<style>
  .montage-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  .montage-intro { max-width: 46ch; margin-top: 0.875rem; }
  .montage-cta { margin-top: 1.75rem; }

  .montage-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .montage-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1.0625rem;
    color: rgba(242, 242, 242, 0.9);
  }
  .montage-list svg {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    margin-top: 0.125rem;
    color: var(--cyan);
  }

  .montage-media {
    overflow: hidden;
    border-radius: 10px;
    /* Seitenverhaeltnis entspricht exakt der Quelldatei (1086x1448 = 3:4),
       damit das komplette Motiv (Kopf bis Werkstueck) sichtbar bleibt statt
       auf einen Ausschnitt zugeschnitten zu werden */
    aspect-ratio: 3 / 4;
    margin: 0;
  }
  .montage-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .montage-grid {
      display: flex;
      align-items: flex-start;
      gap: 3rem;
    }
    .montage-copy { flex: none; }
    .montage-media { flex: none; width: clamp(260px, 24vw, 340px); }
  }
</style>

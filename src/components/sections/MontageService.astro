---
import { montageService } from '@data/site';
---

<section class="section dark-section montage-section" id="montageservice">
  <div class="container">
    <p class="eyebrow">{montageService.eyebrow}</p>
    <h2 class="section-heading">{montageService.heading}</h2>

    <div class="montage-grid">
      <div class="montage-copy reveal">
        <p class="montage-intro">{montageService.intro}</p>
        <a href={montageService.cta.href} class="btn btn-primary montage-cta">{montageService.cta.label}</a>
      </div>

      <div class="montage-right">
        <ul class="montage-list reveal">
          {
            montageService.points.map((point) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span>{point}</span>
              </li>
            ))
          }
        </ul>

        <figure class="montage-media reveal">
          <img src={montageService.image.src} alt={montageService.image.alt} width={montageService.image.width} height={montageService.image.height} loading="lazy" />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .montage-grid {
    display: grid;
    gap: 2rem;
    margin-top: 2.25rem;
    align-items: start;
  }
  .montage-intro { max-width: 46ch; }
  .montage-cta { margin-top: 1.75rem; }

  .montage-list {
    display: grid;
    gap: 1rem;
  }
  .montage-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1.0625rem;
    color: rgba(242, 242, 242, 0.9);
  }
  .montage-list svg {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    margin-top: 0.125rem;
    color: var(--cyan);
  }

  .montage-right { display: flex; flex-direction: column; gap: 1.75rem; }
  .montage-media {
    overflow: hidden;
    border-radius: 10px;
    aspect-ratio: 16 / 9;
  }
  .montage-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 20%;
  }

  @media (min-width: 1024px) {
    .montage-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .montage-media { aspect-ratio: auto; height: 200px; }
  }
</style>

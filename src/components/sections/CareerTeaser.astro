---
import { careerTeaser } from '@data/site';
---

<section class="career-teaser">
  <div class="container career-inner">
    <div>
      <p class="eyebrow">Karriere</p>
      <h2 class="career-heading">{careerTeaser.heading}</h2>
      <p class="career-text">{careerTeaser.text}</p>
    </div>
    <a href="/karriere/" class="btn btn-primary">Zur Karriereseite</a>
  </div>
</section>

<style>
  .career-teaser {
    background: var(--surface);
    border-block: 1px solid rgba(38, 142, 166, 0.15);
    padding-block: 2.5rem;
  }
  .career-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .career-heading { font-size: 1.5rem; margin-top: 0.5rem; }
  .career-text { color: var(--slate); margin-top: 0.375rem; max-width: 52ch; }

  @media (min-width: 768px) {
    .career-inner { flex-direction: row; justify-content: space-between; align-items: center; }
  }
</style>

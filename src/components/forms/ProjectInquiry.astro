---
import { inquiryForm, industries, company } from '@data/site';
---

<div class="inquiry card" id="anfrage">
  <h2 class="inquiry-title">{inquiryForm.heading}</h2>
  <p class="inquiry-intro">{inquiryForm.intro}</p>

  <div class="progress" aria-hidden="true">
    <div class="progress-bar" data-progress style="width: 33.33%"></div>
  </div>
  <p class="step-count" data-step-count aria-live="polite">Schritt 1 von 3</p>

  <form novalidate data-inquiry data-company-email={company.email}>
    <!-- Schritt 1: Anliegen -->
    <fieldset class="step" data-step="1">
      <legend class="step-heading" tabindex="-1">Worum geht es?</legend>
      <div class="chips" role="radiogroup" aria-label="Anliegen">
        {
          inquiryForm.topics.map((topic, i) => (
            <label class="chip">
              <input type="radio" name="anliegen" value={topic} required={i === 0} />
              <span>{topic}</span>
            </label>
          ))
        }
      </div>
      <p class="field-error" data-error-for="anliegen" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" width="16" height="16"><circle cx="12" cy="12" r="9"/><path d="M12 8v5m0 3h.01"/></svg>
        Bitte wählen Sie ein Anliegen aus.
      </p>
      <div class="step-nav">
        <span></span>
        <button type="button" class="btn btn-primary" data-next>Weiter</button>
      </div>
    </fieldset>

    <!-- Schritt 2: Projekt -->
    <fieldset class="step" data-step="2" hidden>
      <legend class="step-heading" tabindex="-1">Ihr Projekt</legend>

      <div class="field">
        <label class="field-label" for="beschreibung">Projektbeschreibung *</label>
        <textarea
          class="field-input"
          id="beschreibung"
          name="beschreibung"
          rows="4"
          placeholder="Beschreiben Sie hier bitte ihr Projekt und geben Sie uns wichtige Details an wie Stückzahl, Material, etc."
          required
          aria-describedby="beschreibung-hint"
        ></textarea>
        <p class="field-hint" id="beschreibung-hint">
          Bauteil, Werkstoff, Stückzahl: alles hilft, nichts ist Pflicht im Detail.
        </p>
        <p class="field-error" data-error-for="beschreibung" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" width="16" height="16"><circle cx="12" cy="12" r="9"/><path d="M12 8v5m0 3h.01"/></svg>
          Bitte beschreiben Sie Ihr Projekt kurz.
        </p>
      </div>

      <div class="field">
        <label class="field-label" for="branche">Branche (optional)</label>
        <select class="field-input" id="branche" name="branche">
          <option value="">Bitte wählen</option>
          {[...industries, 'Sonstiges'].map((b) => <option value={b}>{b}</option>)}
        </select>
      </div>

      <div class="field">
        <div class="notice-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 7.5h.01"/></svg>
          <p>
            Zeichnungen, CAD-Daten oder andere sensible Unterlagen übermitteln wir Ihnen am liebsten persönlich.
            Rufen Sie uns an unter <a href={company.phoneLink}>{company.phoneDisplay}</a> oder schreiben Sie uns
            eine E-Mail an <a href={`mailto:${company.email}`}>{company.email}</a>, den Austausch der Dateien
            klären wir dann gemeinsam. Dieses Formular dient der ersten, unverbindlichen Kontaktaufnahme.
          </p>
        </div>
      </div>

      <div class="step-nav">
        <button type="button" class="btn btn-ghost" data-back>Zurück</button>
        <button type="button" class="btn btn-primary" data-next>Weiter</button>
      </div>
    </fieldset>

    <!-- Schritt 3: Kontakt -->
    <fieldset class="step" data-step="3" hidden>
      <legend class="step-heading" tabindex="-1">Ihre Kontaktdaten</legend>

      <div class="field-row">
        <div class="field">
          <label class="field-label" for="firma">Firma *</label>
          <input class="field-input" type="text" id="firma" name="firma" required autocomplete="organization" />
          <p class="field-error" data-error-for="firma" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" width="16" height="16"><circle cx="12" cy="12" r="9"/><path d="M12 8v5m0 3h.01"/></svg>
            Bitte geben Sie Ihre Firma an.
          </p>
        </div>
        <div class="field">
          <label class="field-label" for="name">Name *</label>
          <input class="field-input" type="text" id="name" name="name" required autocomplete="name" />
          <p class="field-error" data-error-for="name" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" width="16" height="16"><circle cx="12" cy="12" r="9"/><path d="M12 8v5m0 3h.01"/></svg>
            Bitte geben Sie Ihren Namen an.
          </p>
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label class="field-label" for="email">E-Mail *</label>
          <input
            class="field-input"
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            inputmode="email"
          />
          <p class="field-error" data-error-for="email" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" width="16" height="16"><circle cx="12" cy="12" r="9"/><path d="M12 8v5m0 3h.01"/></svg>
            Bitte geben Sie eine gültige E-Mail-Adresse an.
          </p>
        </div>
        <div class="field">
          <label class="field-label" for="telefon">Telefon *</label>
          <input
            class="field-input"
            type="tel"
            id="telefon"
            name="telefon"
            required
            autocomplete="tel"
            inputmode="tel"
          />
          <p class="field-error" data-error-for="telefon" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" width="16" height="16"><circle cx="12" cy="12" r="9"/><path d="M12 8v5m0 3h.01"/></svg>
            Bitte geben Sie Ihre Telefonnummer an.
          </p>
        </div>
      </div>

      <div class="field">
        <label class="field-label" for="nachricht">Ergänzende Nachricht (optional)</label>
        <textarea class="field-input" id="nachricht" name="nachricht" rows="3"></textarea>
      </div>

      <div class="step-nav">
        <button type="button" class="btn btn-ghost" data-back>Zurück</button>
        <button type="submit" class="btn btn-primary" data-submit>
          <span data-submit-label>Anfrage senden</span>
        </button>
      </div>

      <p class="submit-hint">Öffnet eine vorausgefüllte Nachricht in Ihrem E-Mail-Programm.</p>
      <p class="privacy-note">
        {inquiryForm.privacyNote}
        <a href="/datenschutz/">Datenschutzerklärung</a>.
      </p>
    </fieldset>

  </form>

  <!-- Erfolgs-Screen -->
  <div class="success" data-success hidden>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 5-6"/></svg>
    <h3 tabindex="-1" data-success-heading>Ihr E-Mail-Programm öffnet sich jetzt</h3>
    <p>
      Bitte prüfen Sie die vorausgefüllte Nachricht und senden Sie sie ab. Falls sich nichts öffnet, erreichen
      Sie uns direkt: <a href={company.phoneLink}>{company.phoneDisplay}</a> oder
      <a href={`mailto:${company.email}`}>{company.email}</a>.
    </p>
    <div class="mail-fallback">
      <p class="mail-fallback-label">Oder kopieren Sie Ihre Angaben direkt in eine neue E-Mail:</p>
      <textarea class="mail-fallback-text" data-mail-text readonly rows="6"></textarea>
      <div class="mail-fallback-actions">
        <button type="button" class="btn btn-outline" data-copy>In Zwischenablage kopieren</button>
        <span class="copy-status" data-copy-status aria-live="polite"></span>
      </div>
    </div>
    <dl class="summary" data-summary></dl>
  </div>
</div>

<script>
  const root = document.getElementById('anfrage')!;
  const form = root.querySelector<HTMLFormElement>('[data-inquiry]')!;
  const companyEmail = form.dataset.companyEmail!;
  const steps = [...form.querySelectorAll<HTMLFieldSetElement>('.step')];
  const progressBar = root.querySelector<HTMLElement>('[data-progress]')!;
  const stepCount = root.querySelector<HTMLElement>('[data-step-count]')!;
  const successPane = root.querySelector<HTMLElement>('[data-success]')!;

  let current = 0;

  function showError(name: string, show: boolean) {
    const el = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    if (!el) return;
    el.hidden = !show;
    const field = form.querySelector<HTMLElement>(`[name="${name}"], #${name}`);
    field?.setAttribute('aria-invalid', String(show));
  }

  function goTo(index: number, focusHeading = true) {
    steps[current].hidden = true;
    steps[index].hidden = false;
    current = index;
    progressBar.style.width = `${((index + 1) / steps.length) * 100}%`;
    stepCount.textContent = `Schritt ${index + 1} von ${steps.length}`;
    if (focusHeading) {
      const heading = steps[index].querySelector<HTMLElement>('.step-heading');
      heading?.focus();
    }
  }

  function validateStep(index: number): boolean {
    if (index === 0) {
      const checked = form.querySelector<HTMLInputElement>('input[name="anliegen"]:checked');
      showError('anliegen', !checked);
      return !!checked;
    }
    if (index === 1) {
      const desc = form.querySelector<HTMLTextAreaElement>('#beschreibung')!;
      const ok = desc.value.trim().length > 0;
      showError('beschreibung', !ok);
      if (!ok) desc.focus();
      return ok;
    }
    if (index === 2) {
      const firma = form.querySelector<HTMLInputElement>('#firma')!;
      const name = form.querySelector<HTMLInputElement>('#name')!;
      const email = form.querySelector<HTMLInputElement>('#email')!;
      const telefon = form.querySelector<HTMLInputElement>('#telefon')!;
      const firmaOk = firma.value.trim().length > 0;
      const nameOk = name.value.trim().length > 0;
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim());
      const telefonOk = telefon.value.trim().length > 0;
      showError('firma', !firmaOk);
      showError('name', !nameOk);
      showError('email', !emailOk);
      showError('telefon', !telefonOk);
      if (!firmaOk) firma.focus();
      else if (!nameOk) name.focus();
      else if (!emailOk) email.focus();
      else if (!telefonOk) telefon.focus();
      return firmaOk && nameOk && emailOk && telefonOk;
    }
    return true;
  }

  form.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('[data-next]')) {
      if (validateStep(current)) goTo(current + 1);
    } else if (target.closest('[data-back]')) {
      goTo(current - 1);
    }
  });

  // ---------- Absenden per mailto ----------
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validateStep(2)) return;

    const anliegen = form.querySelector<HTMLInputElement>('input[name="anliegen"]:checked')?.value ?? '';
    const beschreibung = form.querySelector<HTMLTextAreaElement>('#beschreibung')!.value.trim();
    const branche = form.querySelector<HTMLSelectElement>('#branche')!.value;
    const firma = form.querySelector<HTMLInputElement>('#firma')!.value.trim();
    const name = form.querySelector<HTMLInputElement>('#name')!.value.trim();
    const email = form.querySelector<HTMLInputElement>('#email')!.value.trim();
    const telefon = form.querySelector<HTMLInputElement>('#telefon')!.value.trim();
    const nachricht = form.querySelector<HTMLTextAreaElement>('#nachricht')!.value.trim();

    const subject = `Projektanfrage: ${anliegen} von ${firma}`;
    const bodyLines = [
      `Anliegen: ${anliegen}`,
      `Firma: ${firma}`,
      `Name: ${name}`,
      `Telefon: ${telefon}`,
      branche ? `Branche: ${branche}` : '',
      '',
      'Projektbeschreibung:',
      beschreibung,
      nachricht ? `\nErgänzende Nachricht:\n${nachricht}` : '',
    ].filter((line) => line !== '');

    const bodyText = bodyLines.join('\n');
    const mailto = `mailto:${companyEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyText)}`;
    const mailText = `An: ${companyEmail}\nBetreff: ${subject}\n\n${bodyText}`;

    // Erst den Erfolgs-Screen mit Kopieren-Fallback zeigen, danach erst versuchen, das
    // Mail-Programm zu oeffnen. So gehen die eingegebenen Daten auf keinen Fall verloren,
    // selbst wenn das Oeffnen fehlschlaegt oder die Seite dabei neu laedt.
    showSuccess({ anliegen, branche, email, mailText });

    // window.location.href = mailto koennte bei fehlendem Mail-Programm die Seite neu
    // laden. window.open() blockiert in diesem Fall nur still, ohne die aktuelle Seite
    // zu verlassen.
    window.open(mailto, '_blank', 'noopener');
  });

  function showSuccess(data: { anliegen: string; branche: string; email: string; mailText: string }) {
    form.hidden = true;
    root.querySelector<HTMLElement>('.progress')!.hidden = true;
    stepCount.hidden = true;
    successPane.hidden = false;

    const mailTextArea = successPane.querySelector<HTMLTextAreaElement>('[data-mail-text]')!;
    mailTextArea.value = data.mailText;
    const copyStatus = successPane.querySelector<HTMLElement>('[data-copy-status]')!;
    copyStatus.textContent = '';

    const summary = successPane.querySelector<HTMLElement>('[data-summary]')!;
    const rows: [string, string][] = [
      ['Anliegen', data.anliegen],
      ['Branche', data.branche || 'Keine Angabe'],
      ['Antwort an', data.email],
    ];
    summary.innerHTML = '';
    for (const [dt, dd] of rows) {
      const dtEl = document.createElement('dt');
      dtEl.textContent = dt;
      const ddEl = document.createElement('dd');
      ddEl.textContent = dd;
      summary.append(dtEl, ddEl);
    }
    successPane.querySelector<HTMLElement>('[data-success-heading]')!.focus();
  }

  successPane.querySelector('[data-copy]')?.addEventListener('click', async () => {
    const mailTextArea = successPane.querySelector<HTMLTextAreaElement>('[data-mail-text]')!;
    const copyStatus = successPane.querySelector<HTMLElement>('[data-copy-status]')!;
    mailTextArea.select();
    mailTextArea.setSelectionRange(0, mailTextArea.value.length);
    try {
      await navigator.clipboard.writeText(mailTextArea.value);
      copyStatus.textContent = 'In die Zwischenablage kopiert.';
    } catch {
      copyStatus.textContent = 'Kopieren fehlgeschlagen, der Text ist markiert: bitte mit Strg+C kopieren.';
    }
  });
</script>

<style>
  .inquiry {
    padding: 1.5rem 1.25rem;
    box-shadow: 0 24px 60px rgba(16, 26, 38, 0.35);
  }
  .inquiry-title {
    font-size: 1.5rem;
  }
  .inquiry-intro {
    color: var(--slate);
    font-size: 0.9375rem;
    margin-top: 0.25rem;
  }

  .progress {
    height: 4px;
    background: rgba(38, 142, 166, 0.18);
    border-radius: 2px;
    margin-top: 1.125rem;
    overflow: hidden;
  }
  .progress-bar {
    height: 100%;
    background: var(--petrol);
    transition: width 0.25s ease;
  }
  .step-count {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--slate);
    margin: 0.5rem 0 1rem;
  }

  .step { border: 0; padding: 0; margin: 0; min-width: 0; }
  .step-heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--ink);
    padding: 0;
    margin-bottom: 0.875rem;
  }
  .step-heading:focus-visible { outline-offset: 4px; }

  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { position: relative; }
  .chip input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-card);
    border-radius: 999px;
    font-weight: 500;
    color: var(--ink);
    background: var(--surface);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .chip input:hover + span { border-color: var(--petrol); }
  .chip input:checked + span {
    background: var(--petrol-deep);
    border-color: var(--petrol-deep);
    color: #fff;
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--petrol-deep);
    outline-offset: 2px;
  }

  .field { margin-bottom: 1rem; min-width: 0; }
  .field-row { display: grid; gap: 0 1rem; }
  @media (min-width: 480px) {
    .field-row { grid-template-columns: 1fr 1fr; }
  }

  .notice-box {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    border: 1px solid var(--border-card);
    background: var(--paper);
    border-radius: 8px;
    padding: 0.875rem 1rem;
    font-size: 0.875rem;
    color: var(--slate);
  }
  .notice-box svg { width: 1.25rem; height: 1.25rem; color: var(--petrol); flex: none; margin-top: 0.125rem; }
  .notice-box a { color: var(--petrol-deep); font-weight: 600; }

  .step-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.25rem;
  }

  .submit-hint {
    font-size: 0.8125rem;
    color: var(--slate);
    margin-top: 0.75rem;
  }
  .privacy-note {
    font-size: 0.8125rem;
    color: var(--slate);
    margin-top: 0.375rem;
  }
  .privacy-note a { color: var(--petrol-deep); }

  .success { text-align: left; padding-top: 0.5rem; }
  .success svg { width: 3rem; height: 3rem; color: var(--petrol); }
  .success h3 { font-size: 1.375rem; margin-top: 0.75rem; }
  .success p { color: var(--slate); margin-top: 0.375rem; }

  .mail-fallback { margin-top: 1.25rem; }
  .mail-fallback-label { font-size: 0.875rem; font-weight: 600; color: var(--ink); margin-bottom: 0.375rem; }
  .mail-fallback-text {
    width: 100%;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8125rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--border-card);
    border-radius: 8px;
    padding: 0.75rem;
    resize: vertical;
  }
  .mail-fallback-actions { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.625rem; flex-wrap: wrap; }
  .copy-status { font-size: 0.8125rem; color: var(--slate); }
  .summary {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.375rem 1.25rem;
    font-size: 0.9375rem;
  }
  .summary dt { font-weight: 600; color: var(--slate); }

  @media (min-width: 640px) {
    .inquiry { padding: 2rem 1.75rem; }
  }
</style>

---
import { company, navItems } from "@data/site";
---

<header class="site-header">
  <a class="brand" href="/" aria-label={`${company.name} Startseite`}>
    <img src="/images/logoschreck.png" alt={company.name} />
  </a>
  <nav class="desktop-nav" aria-label="Hauptnavigation">
    {
      navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
  </nav>
  <div class="header-actions">
    <a class="header-phone" href={`tel:${company.phone.replace(/\s/g, "")}`} aria-label="Anrufen">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.05 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16v.92z"/>
      </svg>
    </a>
    <a class="contact" href={`mailto:${company.email}?subject=Projektanfrage`} aria-label="E-Mail Anfrage senden">Anfragen</a>
    <button class="menu-toggle" aria-label="Menü öffnen" aria-expanded="false">
      <svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>
</header>

<div class="mobile-nav" aria-label="Mobile Navigation">
  <nav>
    {
      navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
    <a href="/maschinen-ausstattung/">Maschinen &amp; Ausstattung</a>
    <a href="/downloads/">Downloads</a>
  </nav>
  <div class="mobile-nav-contact">
    <a href={`tel:${company.phone.replace(/\s/g, "")}`}>{company.phone}</a>
    <a href={`mailto:${company.email}`}>{company.email}</a>
  </div>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const mobileNav = document.querySelector<HTMLElement>(".mobile-nav");

  if (toggle && mobileNav) {
    toggle.addEventListener("click", () => {
      const open = mobileNav.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
    });

    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileNav.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      });
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 20;
    top: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 28px;
    align-items: center;
    padding: 14px max(20px, calc((100vw - 1180px) / 2));
    border-bottom: 1px solid rgba(15, 31, 53, 0.1);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(18px);
    box-shadow: 0 10px 34px rgba(12, 18, 32, 0.06);
    color: var(--primary-deep);
  }

  .brand img {
    width: 172px;
    height: auto;
  }

  .desktop-nav {
    display: flex;
    justify-content: center;
    gap: clamp(14px, 1.5vw, 24px);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .desktop-nav a {
    color: rgba(15, 31, 53, 0.78);
  }

  .desktop-nav a:hover {
    color: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header-phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(8, 145, 178, 0.28);
    border-radius: 999px;
    color: var(--primary-deep);
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.08), rgba(8, 145, 178, 0.14));
    transition: color 180ms, border-color 180ms;
  }

  .header-phone:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .contact {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(8, 145, 178, 0.28);
    border-radius: 999px;
    padding: 0 18px;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.12), rgba(8, 145, 178, 0.18));
    color: var(--primary-deep);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Hamburger toggle */
  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(8, 145, 178, 0.28);
    border-radius: 999px;
    padding: 0;
    background: linear-gradient(135deg, rgba(8, 145, 178, 0.08), rgba(8, 145, 178, 0.14));
    color: var(--primary-deep);
    cursor: pointer;
    transition: color 180ms, border-color 180ms;
  }

  .menu-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .menu-toggle .icon-close {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .icon-open {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .icon-close {
    display: block;
  }

  /* Mobile nav overlay */
  .mobile-nav {
    position: fixed;
    z-index: 19;
    inset: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 100px 28px 40px;
    background: rgba(15, 31, 53, 0.97);
    backdrop-filter: blur(18px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 220ms ease, visibility 220ms ease;
  }

  .mobile-nav.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mobile-nav nav a {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 160ms;
  }

  .mobile-nav nav a:hover {
    color: var(--accent-light);
  }

  .mobile-nav-contact {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mobile-nav-contact a {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .mobile-nav-contact a:hover {
    color: var(--accent-light);
  }

  @media (max-width: 980px) {
    .site-header {
      grid-template-columns: 1fr auto;
      gap: 14px;
      padding: 12px 14px;
    }

    .desktop-nav {
      grid-column: 1 / -1;
      justify-content: flex-start;
      overflow-x: auto;
      padding: 0 0 2px;
      scrollbar-width: none;
    }

    .desktop-nav::-webkit-scrollbar {
      display: none;
    }

    .brand img {
      width: 150px;
    }
  }

  @media (max-width: 760px) {
    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .brand img {
      width: 126px;
    }

    .header-phone {
      width: 36px;
      height: 36px;
    }

    .contact {
      min-height: 36px;
      padding: 0 12px;
      font-size: 0.86rem;
    }

    .menu-toggle {
      width: 36px;
      height: 36px;
    }
  }

  /* Hide mobile nav on desktop */
  @media (min-width: 761px) {
    .mobile-nav {
      display: none;
    }
  }
</style>

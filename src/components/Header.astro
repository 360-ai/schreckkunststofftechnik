---
import { nav, company } from '@data/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Startseite Schreck Kunststofftechnik GmbH">
      <img src="/images/logo-schreck.png" alt={company.name} width="560" height="148" loading="eager" />
    </a>

    <nav class="main-nav" aria-label="Hauptnavigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href={company.phoneLink} class="btn btn-outline phone-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 5c0-1 .8-2 1.9-2h2.3c.9 0 1.6.6 1.9 1.4l.9 2.8c.2.8 0 1.6-.7 2.1l-1.2 1a13.5 13.5 0 0 0 5.6 5.6l1-1.2c.5-.7 1.3-.9 2.1-.7l2.8.9c.8.3 1.4 1 1.4 1.9v2.3c0 1.1-1 1.9-2 1.9C10.6 21 3 13.4 4 5Z" />
        </svg>
        <span class="phone-label">{company.phoneDisplay}</span>
        <span class="visually-hidden">Anrufen</span>
      </a>
      <a href="/#anfrage" class="btn btn-primary inquiry-btn">Projekt anfragen</a>

      <a href={company.instagram} class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Schreck Kunststofftechnik auf Instagram">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
        </svg>
      </a>

      <button
        class="burger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menü öffnen"
      >
        <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Mobile Navigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="menu-cta">
          <a href="/#anfrage" class="btn btn-primary">Projekt anfragen</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header')!;
  const burger = header.querySelector<HTMLButtonElement>('.burger')!;
  const menu = header.querySelector<HTMLElement>('#mobile-menu')!;

  function setOpen(open: boolean) {
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    menu.hidden = !open;
    document.documentElement.classList.toggle('menu-open', open);
  }

  burger.addEventListener('click', () => {
    setOpen(burger.getAttribute('aria-expanded') !== 'true');
  });

  // Menü schließt bei Linkklick und bei Escape (Fokus zurück auf den Button, keine Fokus-Falle)
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      burger.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface);
    border-bottom: 1px solid rgba(38, 142, 166, 0.2);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
  }
  .brand { display: inline-flex; flex: none; }
  .brand img {
    width: auto;
    height: 2.25rem;
  }

  .main-nav { display: none; }
  .main-nav ul { display: flex; gap: 1.75rem; }
  .main-nav a {
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.35rem;
    border-bottom: 2px solid transparent;
  }
  .main-nav a:hover { color: var(--petrol-deep); }
  .main-nav a[aria-current='page'] {
    border-bottom-color: var(--petrol);
    color: var(--ink);
  }

  .header-actions { display: flex; align-items: center; gap: 0.625rem; }
  .phone-btn .phone-label { display: none; }
  .phone-btn { padding-inline: 0.75rem; }
  .inquiry-btn { display: none; }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--ink);
    flex: none;
  }
  .social-link svg { width: 1.375rem; height: 1.375rem; }
  .social-link:hover { color: var(--petrol-deep); }

  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 1px solid rgba(38, 142, 166, 0.35);
    border-radius: 8px;
    color: var(--ink);
    cursor: pointer;
  }
  .burger svg { width: 1.375rem; height: 1.375rem; }
  .burger .icon-close { display: none; }
  .burger[aria-expanded='true'] .icon-open { display: none; }
  .burger[aria-expanded='true'] .icon-close { display: block; }

  .mobile-menu {
    border-top: 1px solid rgba(38, 142, 166, 0.2);
    background: var(--surface);
  }
  .mobile-menu ul { padding: 0.75rem 1.25rem 1.25rem; }
  .mobile-menu a:not(.btn) {
    display: block;
    padding: 0.75rem 0.25rem;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(38, 142, 166, 0.15);
  }
  .mobile-menu a[aria-current='page']:not(.btn) { color: var(--petrol-deep); }
  .menu-cta { padding-top: 1rem; }
  .menu-cta .btn { width: 100%; }

  @media (min-width: 640px) {
    .phone-btn .phone-label { display: inline; }
  }
  @media (min-width: 1024px) {
    .main-nav { display: block; }
    .inquiry-btn { display: inline-flex; }
    .burger { display: none; }
    .mobile-menu { display: none; }
    .brand img { height: 2.5rem; }
  }
</style>

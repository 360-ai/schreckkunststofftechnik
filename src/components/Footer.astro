---
import { nav, company, certificate } from '@data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer dark-section">
  <div class="container footer-grid">
    <div class="footer-col">
      <p class="footer-brand">Schreck Kunststofftechnik GmbH</p>
      <address>
        {company.street}<br />
        {company.zip} {company.city}
      </address>
      <ul class="footer-contact">
        <li>
          <a href={company.phoneLink}>Telefon {company.phoneDisplay}</a>
        </li>
        <li>Fax {company.faxDisplay}</li>
        <li>
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </li>
        <li>
          <a href={company.instagram} class="footer-social" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
            </svg>
            Instagram
          </a>
        </li>
      </ul>
    </div>

    <nav class="footer-col" aria-label="Footer-Navigation">
      <p class="footer-heading">Seiten</p>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
        <li><a href="/#anfrage">Projekt anfragen</a></li>
      </ul>
    </nav>

    <div class="footer-col">
      <p class="footer-heading">Qualität</p>
      <p class="footer-cert">
        Zertifiziert nach {certificate.norm}, {certificate.scope}. Ausgestellt von {certificate.authority}, gültig bis {certificate.validTo}.
      </p>
      <a class="footer-cert-link" href={certificate.pdf}>Zertifikat als PDF</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} {company.name}</p>
    <ul class="footer-legal">
      <li><a href="/impressum/">Impressum</a></li>
      <li><a href="/datenschutz/">Datenschutz</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { padding-top: 3.5rem; }
  .footer-grid {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .footer-brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--surface);
    margin-bottom: 0.75rem;
  }
  address { font-style: normal; color: rgba(242, 242, 242, 0.78); }
  .footer-contact { margin-top: 1rem; display: grid; gap: 0.35rem; color: rgba(242, 242, 242, 0.78); }
  .footer-heading {
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.8125rem;
    color: var(--cyan);
    margin-bottom: 0.875rem;
  }
  .footer-col ul { display: grid; gap: 0.4rem; }
  .site-footer a {
    color: rgba(242, 242, 242, 0.9);
    text-decoration: none;
  }
  .site-footer a:hover { color: var(--cyan); }
  .footer-social { display: inline-flex; align-items: center; gap: 0.4rem; }
  .footer-social svg { width: 1.0625rem; height: 1.0625rem; flex: none; }
  .footer-cert { font-size: 0.9375rem; max-width: 34ch; }
  .footer-cert-link {
    display: inline-block;
    margin-top: 0.625rem;
    text-decoration: underline !important;
    text-underline-offset: 3px;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.25rem;
    border-top: 1px solid rgba(242, 242, 242, 0.15);
    font-size: 0.9375rem;
    color: rgba(242, 242, 242, 0.78);
  }
  .footer-legal { display: flex; gap: 1.5rem; }

  @media (min-width: 768px) {
    .footer-grid { grid-template-columns: 1.3fr 0.8fr 1fr; }
  }
</style>

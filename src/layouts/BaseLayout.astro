---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import "@styles/global.css";
import { capabilities, company, industries, products, siteUrl } from "@data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  robots?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/images/hero2.jpg",
  canonical,
  robots = "index, follow",
  jsonLd = []
} = Astro.props;

const pageTitle = title.includes(company.name) ? title : `${title} | ${company.name}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const imageUrl = new URL(image, Astro.site).toString();
const organizationId = new URL("/#organization", Astro.site).toString();
const websiteId = new URL("/#website", Astro.site).toString();
const customSchemas = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const segmentLabels: Record<string, string> = {
  produkte: "Produkte",
  kompetenzen: "Kompetenzen",
  "qualitaet-zertifizierung": "Qualität & Zertifizierung",
  "maschinen-ausstattung": "Maschinen & Ausstattung",
  "ueber-uns": "Über uns",
  karriere: "Karriere",
  kontakt: "Kontakt",
  downloads: "Downloads",
  impressum: "Impressum",
  datenschutz: "Datenschutz",
  ...Object.fromEntries(products.map((product) => [product.slug, product.title]))
};
const hasCustomBreadcrumb = customSchemas.some((schema) => schema?.["@type"] === "BreadcrumbList");
const generatedBreadcrumb = pathSegments.length > 0 && !Astro.url.pathname.includes("404")
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Startseite", item: new URL("/", Astro.site).toString() },
        ...pathSegments.map((segment, index) => ({
          "@type": "ListItem",
          position: index + 2,
          name: index === pathSegments.length - 1 ? title : (segmentLabels[segment] ?? segment),
          item: new URL(`/${pathSegments.slice(0, index + 1).join("/")}/`, Astro.site).toString()
        }))
      ]
    }
  : null;
const defaultSchemas = [
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "LocalBusiness"],
    "@id": organizationId,
    name: company.name,
    legalName: company.name,
    url: siteUrl,
    email: company.email,
    telephone: company.phone,
    faxNumber: company.fax,
    foundingDate: "1984-01-01",
    numberOfEmployees: { "@type": "QuantitativeValue", value: 14 },
    slogan: company.claim,
    logo: new URL("/images/logoschreck.png", Astro.site).toString(),
    address: {
      "@type": "PostalAddress",
      streetAddress: company.street,
      postalCode: company.postalCode,
      addressLocality: company.locality,
      addressRegion: company.region,
      addressCountry: company.country
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: company.geo.latitude,
      longitude: company.geo.longitude
    },
    areaServed: [
      { "@type": "Country", name: "Deutschland" },
      { "@type": "State", name: company.region }
    ],
    contactPoint: {
      "@type": "ContactPoint",
      telephone: company.phone,
      email: company.email,
      contactType: "sales",
      areaServed: "DE",
      availableLanguage: ["de"]
    },
    knowsAbout: [
      ...industries,
      ...capabilities,
      ...products.flatMap((product) => product.keywords)
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": websiteId,
    url: siteUrl,
    name: company.name,
    inLanguage: "de-DE",
    publisher: { "@id": organizationId }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: pageTitle,
    description,
    inLanguage: "de-DE",
    isPartOf: { "@id": websiteId },
    about: { "@id": organizationId }
  },
  ...(!hasCustomBreadcrumb && generatedBreadcrumb ? [generatedBreadcrumb] : [])
];
const schemas = [...defaultSchemas, ...customSchemas.filter(Boolean)];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="de" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={`${company.name} - Formenbau und Kunststofftechnik`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Schreck Kunststofftechnik GmbH" />
    <meta name="theme-color" content="#0f1f35" />
    <!-- GEO-Targeting -->
    <meta name="geo.region" content="DE-HE" />
    <meta name="geo.placename" content="Burgwald-Bottendorf" />
    <meta name="geo.position" content="51.017;8.832" />
    <meta name="ICBM" content="51.017, 8.832" />
    <!-- Robots -->
    <meta name="robots" content={robots} />
    {/* ACHTUNG DSGVO: Dieser GA4-Block laedt, SOBALD PUBLIC_GA_ID gesetzt wird — ohne Consent!
        Die Variable darf erst gesetzt werden, wenn ein Consent-Banner (Opt-in, § 25 TDDDG)
        davor haengt und GA4 erst nach Einwilligung initialisiert wird. Die storage-Parameter
        unten sind KEIN Ersatz fuer eine Einwilligung. Zusaetzlich noetig: AVV mit Google +
        GA4-Abschnitt in der Datenschutzerklaerung (Abschnitt 6 anpassen). */}
    {import.meta.env.PUBLIC_GA_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}></script>
        <script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId, {
            anonymize_ip: true,
            storage: 'none',
            client_storage: 'none',
            storeGac: false
          });
        </script>
      </>
    )}
    <link rel="icon" href="/images/logoschreck%20(1).png" />
    <link rel="apple-touch-icon" href="/images/logoschreck%20(1).png" />
    {
      schemas.map((schema) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

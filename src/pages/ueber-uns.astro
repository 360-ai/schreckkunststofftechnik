---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import { company, stats, machinePark, machineLimits, certificate } from "@data/site";

const faqs = [
  { q: "Wann wurde Schreck Kunststofftechnik gegründet?", a: "Schreck Kunststofftechnik wurde am 1. Januar 1984 gegründet. Eine der ersten Maschinen war eine Spritzgießmaschine, um Formen mit Abmusterungsprotokoll serienreif auszuliefern." },
  { q: "Wie groß ist das Team von Schreck?", a: "Schreck Kunststofftechnik beschäftigt 14 Mitarbeiter. Seit der Gründung wurden außerdem mehr als 30 Lehrlinge ausgebildet." },
  { q: "Wie viele Formen hat Schreck gebaut?", a: "Seit 1984 wurden mehr als 1.000 Formen gebaut und zur Serienreife gebracht. Diese Kennzahl beschreibt die dokumentierte Unternehmenshistorie, nicht eine Zusage für ein einzelnes Projekt." },
  { q: "Wo befindet sich Schreck Kunststofftechnik?", a: "Der Unternehmenssitz liegt in der Wolkersdorfer Straße 28, 35099 Burgwald-Bottendorf in Hessen. Telefon, E-Mail und Routenlink stehen auf der Kontaktseite." }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } }))
};
---

<BaseLayout
  title="Schreck Kunststofftechnik – Unternehmen seit 1984"
  description="Schreck Kunststofftechnik GmbH ist ein Formenbau-Unternehmen aus Burgwald-Bottendorf mit Erfahrung seit 1984."
  jsonLd={faqSchema}
>
  <PageHero eyebrow="Über uns" title="Formenbau in Burgwald-Bottendorf seit 1984" text="Schreck Kunststofftechnik ist ein Werkzeug- und Formenbauer mit 14 Mitarbeitern. Mehr als 1.000 Formen wurden seit der Gründung bis zur Serienreife gebracht." image="/images/luftbild_skt.webp" />
  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Unternehmen</p>
        <h2>Ein spezialisierter Betrieb für Werkzeug- und Formenbau.</h2>
        <p class="lead">Schreck entwickelt und fertigt Formen für Kunststoffverarbeitung sowie Aluminium- und Zink-Druckguss. Konstruktion, Abmusterung, Vermessung und Optimierung greifen bis zur Serienreife ineinander.</p>
      </div>
      <div class="image-panel">
        <img src="/images/team.jpg" alt="Team der Schreck Kunststofftechnik GmbH" width="800" height="533" loading="lazy" />
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Häufige Fragen</p>
      <h2>Unternehmen und Geschichte</h2>
      <div class="faq-list">{faqs.map(({ q, a }) => <details class="faq-item"><summary>{q}</summary><div class="faq-answer">{a}</div></details>)}</div>
    </div>
  </section>
  <section class="section soft">
    <div class="container">
      <p class="eyebrow">Arbeitsweise</p>
      <h2>Was den Projektweg bei Schreck prägt</h2>
      <div class="grid three profile-grid">
        <article class="card"><div class="card-body"><h3>Eigene Abmusterung</h3><p>Hergestellte Formen können auf eigenen Spritzgießmaschinen abgemustert werden. Dieser Ansatz gehört seit den frühen Unternehmensjahren zum Betriebskonzept.</p><a href="#maschinen">Maschinenpark ansehen &rarr;</a></div></article>
        <article class="card"><div class="card-body"><h3>Zertifizierter Geltungsbereich</h3><p>Das ISO-9001-Zertifikat gilt für den Formenbau von der Konstruktion bis zur Serienreife und ist bis 27.06.2027 gültig.</p><a href="#zertifikat">Zertifikat ansehen &rarr;</a></div></article>
        <article class="card"><div class="card-body"><h3>Ausbildung und Fachwissen</h3><p>Mehr als 30 Lehrlinge wurden seit der Gründung ausgebildet. Reparaturen und Schulungen des Fachpersonals gehören zum belegten Leistungsumfang.</p><a href="/karriere/">Karriere ansehen &rarr;</a></div></article>
      </div>
    </div>
  </section>
  <section class="section dark">
    <div class="container">
      <p class="eyebrow">Kennzahlen</p>
      <h2>Erfahrung, die in jedem Projekt mitarbeitet.</h2>
      <div class="stat-grid">
        {stats.map((stat) => <div class="stat"><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Firmengeschichte</p>
      <h2>Seit 1984 im Formenbau verwurzelt.</h2>
      <div class="history-timeline">
        <article class="history-entry">
          <span class="history-date">01.01.1984</span>
          <div>
            <h3>Gründung</h3>
            <p>Schreck Kunststofftechnik wird gegründet und richtet den Fokus früh auf Formenbau für die Kunststoffverarbeitung.</p>
          </div>
        </article>
        <article class="history-entry">
          <span class="history-date">Frühe Jahre</span>
          <div>
            <h3>Abmusterung auf eigener Maschine</h3>
            <p>Eine der ersten erworbenen Maschinen ist eine Spritzgießmaschine. Dadurch können Formen mit Abmusterungsprotokoll und serienreifer Auslegung ausgeliefert werden.</p>
          </div>
        </article>
        <article class="history-entry">
          <span class="history-date">Bis heute</span>
          <div>
            <h3>Mehr als 1000 Formen</h3>
            <p>Seit der Gründung wurden mehr als 1000 Formen gebaut und zur Serienreife gebracht. Mehr als 30 Lehrlinge wurden ausgebildet.</p>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section class="section soft" id="maschinen">
    <div class="container">
      <div class="intro-grid">
        <div>
          <p class="eyebrow">Maschinen &amp; Ausstattung · Stand 01/2024</p>
          <h2>Fertigung, Abmusterung und Messtechnik im Haus</h2>
        </div>
        <p class="lead">Der dokumentierte Maschinenpark verbindet mechanische Bearbeitung, zwei Spritzgießmaschinen für die Abmusterung, Cimatron-Arbeitsplätze und eigene Messtechnik. Für die projektbezogene Verfügbarkeit sprechen Sie das Team bitte direkt an.</p>
      </div>
      <div class="equipment-grid">
        {machinePark.map((group) => (
          <article class="equipment-card">
            <h3>{group.area}</h3>
            <ul>{group.entries.map((entry) => <li>{entry}</li>)}</ul>
          </article>
        ))}
      </div>
      <div class="stat-grid limits">
        {machineLimits.map((limit) => <div class="stat"><strong>{limit.value}</strong><span>{limit.label}</span></div>)}
      </div>
      <p class="source-note">Stand dieser Kapazitätsangaben: 01/2024. Die konkrete Machbarkeit hängt von Geometrie, Aufbau und Projektanforderungen ab.</p>
    </div>
  </section>

  <section class="section" id="zertifikat">
    <div class="container split">
      <div>
        <p class="eyebrow">Qualität · {certificate.norm}</p>
        <h2>Geprüfte Abläufe von der Konstruktion bis zur Serienreife</h2>
        <p class="lead">Das Zertifikat der {certificate.authority} gilt für „{certificate.scope}“. Es ist von {certificate.validity.replace("–", " bis ")} gültig. Die Qualitätssicherung nutzt eigene Messtechnik (Werth Profile-Projector, Tesa Micro Hite, 20-fach Messmikroskop, Koordinatenmessgerät PIONEER).</p>
        <a class="button" href={certificate.pdf}>ISO-Zertifikat öffnen</a>
      </div>
      <dl class="certificate-card">
        <div><dt>Norm</dt><dd>{certificate.norm}</dd></div>
        <div><dt>Geltungsbereich</dt><dd>{certificate.scope}</dd></div>
        <div><dt>Zertifikatsnummer</dt><dd>{certificate.number}</dd></div>
        <div><dt>Gültigkeit</dt><dd>{certificate.validity}</dd></div>
        <div><dt>Zertifizierungsstelle</dt><dd>{certificate.authority}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <p class="eyebrow">Standort</p>
      <h2>{company.location}</h2>
      <p class="lead">{company.street}, {company.postalCity}</p>
      <!-- Kein Maps-iframe: wuerde ohne Consent Besucherdaten an Google senden (DSGVO).
           Stattdessen Link wie auf /kontakt/. Two-Click-Loesung erst mit Consent-Manager. -->
      <div class="map-embed map-link-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="#04748a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="40" height="40"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <p><strong>{company.name}</strong><br />{company.street}, {company.postalCity}</p>
        <a
          class="button"
          aria-label="Route in Google Maps planen (neuer Tab)"
          href="https://www.google.com/maps/search/?api=1&query=Wolkersdorfer+Stra%C3%9Fe+28,+35099+Burgwald-Bottendorf"
          target="_blank"
          rel="noopener noreferrer"
        >Route in Google Maps planen &rarr;</a>
      </div>
      <div class="button-row site-links">
        <a class="button light" href="#maschinen">Maschinen &amp; Ausstattung</a>
        <a class="button light" href="/kontakt/">Projekt besprechen</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .map-link-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 48px 24px;
    text-align: center;
    background: rgba(8, 145, 178, 0.12);
    border: 1px solid rgba(8, 145, 178, 0.35);
    border-radius: 8px;
  }

  .map-link-box p {
    margin: 0;
  }

  .profile-grid {
    margin-top: 34px;
  }

  .profile-grid a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-top: 16px;
    color: var(--accent-text);
    font-weight: 800;
  }

  .site-links {
    margin-top: 24px;
  }

  #maschinen,
  #zertifikat {
    scroll-margin-top: 110px;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 42px;
    align-items: end;
  }

  .equipment-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 40px;
  }

  .equipment-card {
    padding: 24px;
    border: 1px solid rgba(8, 145, 178, 0.35);
    border-radius: 8px;
    background: rgba(8, 145, 178, 0.12);
  }

  .equipment-card h3 {
    margin-bottom: 14px;
  }

  .equipment-card ul {
    margin: 0;
    padding-left: 20px;
    color: var(--muted);
  }

  .equipment-card li + li {
    margin-top: 8px;
  }

  .limits {
    margin-top: 34px;
  }

  .limits strong {
    font-size: clamp(1.5rem, 3vw, 2.3rem);
  }

  .source-note {
    margin-top: 24px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .certificate-card {
    margin: 0;
    padding: 28px;
    border: 1px solid rgba(8, 145, 178, 0.35);
    border-radius: 8px;
    background: rgba(8, 145, 178, 0.12);
  }

  .certificate-card div + div {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid rgba(8, 145, 178, 0.22);
  }

  .certificate-card dt {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .certificate-card dd {
    margin: 4px 0 0;
    color: var(--primary-deep);
    font-weight: 800;
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .intro-grid,
    .equipment-grid {
      grid-template-columns: 1fr;
    }
  }

  .history-timeline {
    margin-top: 40px;
    display: grid;
    gap: 1px;
    background: var(--line);
    border-radius: 8px;
    overflow: hidden;
  }

  .history-entry {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    padding: 28px 32px;
    background: #fff;
    align-items: start;
  }

  .history-date {
    color: var(--accent-text);
    font-weight: 900;
    font-size: 0.9rem;
    padding-top: 4px;
  }

  .history-entry h3 {
    margin: 0 0 8px 0;
    font-size: 1.1rem;
  }

  .history-entry p {
    color: var(--muted);
    line-height: 1.68;
    margin: 0;
  }

  @media (max-width: 640px) {
    .history-entry {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 20px 20px;
    }
  }
</style>

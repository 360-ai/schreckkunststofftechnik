---
import BaseLayout from '@layouts/BaseLayout.astro';
import { productGroups, aiProductNotice, seo } from '@data/site';
---

<BaseLayout
  title={seo.produkte.title}
  description={seo.produkte.description}
  breadcrumbs={[{ name: 'Produkte', href: '/produkte/' }]}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Produkte</p>
      <h1 class="section-heading">Spritzgusswerkzeuge für sechs Produktgruppen</h1>
      <p class="page-intro">
        Alle Inhalte stammen aus den SKT-Prospekten. Jede Gruppe hat einen eigenen Prospekt als PDF, den Sie direkt herunterladen können.
      </p>
      <nav class="anchor-nav" aria-label="Produktgruppen">
        <ul>
          {productGroups.map((g) => (
            <li>
              <a href={`#${g.id}`}>{g.cardTitle}</a>
            </li>
          ))}
          <li>
            <a href="#ki-bildhinweis" class="ai-notice-link">Hinweis zu den Abbildungen</a>
          </li>
        </ul>
      </nav>
    </div>
  </section>

  {
    productGroups.map((group, index) => (
      <section id={group.id} class:list={['section', 'product-section', index % 2 === 1 && 'alt']}>
        <div class="container product-layout">
          <div class="product-copy">
            <p class="eyebrow">Produktgruppe</p>
            <h2 class="section-heading">{group.title}</h2>
            {group.intro.map((p) => (
              <p class="product-intro">{p}</p>
            ))}

            <h3 class="sub-heading">{group.examplesLabel}</h3>
            <ul class="pill-list">
              {group.examples.map((example) => (
                <li class="pill">{example}</li>
              ))}
            </ul>

            <h3 class="sub-heading">Ansprüche an die Form</h3>
            <ul class="demand-list">
              {group.demands.map((demand) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="m5 13 4 4L19 7" />
                  </svg>
                  {demand}
                </li>
              ))}
            </ul>

            <div class="product-actions">
              <a href={group.pdf.href} class="btn btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M12 4v12m0 0 4-4m-4 4-4-4" />
                  <path d="M4 17v1a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1" />
                </svg>
                Prospekt als PDF
              </a>
              <a href="/#anfrage" class="btn btn-outline">Projekt anfragen</a>
            </div>
          </div>

          <div class="product-figures">
            {group.images.map((img) => (
              <figure class="card product-figure reveal">
                <a href="#ki-bildhinweis" class="ai-badge">KI generiert</a>
                <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" />
              </figure>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section ai-notice-section" id="ki-bildhinweis">
    <div class="container ai-notice">
      <p class="ai-notice-heading">{aiProductNotice.heading}</p>
      <p class="ai-notice-text">{aiProductNotice.text}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: var(--surface);
    border-bottom: 1px solid rgba(38, 142, 166, 0.15);
    padding-block: 2.75rem 2rem;
  }
  .page-intro { color: var(--slate); margin-top: 0.875rem; max-width: 60ch; }

  .anchor-nav { margin-top: 1.5rem; }
  .anchor-nav ul { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .anchor-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4rem 1rem;
    border: 1px solid var(--border-card);
    border-radius: 999px;
    color: var(--petrol-deep);
    font-weight: 500;
    text-decoration: none;
  }
  .anchor-nav a:hover { border-color: var(--petrol); color: var(--ink); }

  .product-section.alt { background: var(--surface); }
  .product-layout { display: grid; gap: 2rem; }
  .product-intro { color: var(--slate); margin-top: 1rem; }

  .sub-heading {
    font-size: 1.0625rem;
    margin-top: 1.75rem;
    margin-bottom: 0.625rem;
  }
  .pill-list { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .demand-list { display: grid; gap: 0.45rem; }
  .demand-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    color: var(--slate);
    font-size: 0.9875rem;
  }
  .demand-list svg { width: 1.125rem; height: 1.125rem; color: var(--petrol); flex: none; margin-top: 0.2rem; }

  .product-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .ai-notice-link { color: var(--slate) !important; font-size: 0.9375rem; }

  .ai-notice-section { border-top: 1px solid rgba(38, 142, 166, 0.15); }
  .ai-notice { max-width: 68ch; }
  .ai-notice-heading {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--slate);
    margin-bottom: 0.5rem;
  }
  .ai-notice-text { color: var(--slate); font-size: 0.875rem; line-height: 1.6; }

  .product-figures { display: grid; gap: 1rem; align-content: start; }
  .product-figure { position: relative; }
  .ai-badge {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    background: rgba(242, 242, 242, 0.9);
    color: var(--slate);
    font-size: 0.5rem;
    font-weight: 500;
    padding: 0.1rem 0.35rem;
    border-radius: 999px;
    border: 1px solid rgba(38, 142, 166, 0.2);
    text-decoration: none;
  }
  .ai-badge:hover { color: var(--petrol-deep); border-color: var(--petrol); }
  .product-figure {
    padding: 1rem;
    display: grid;
    place-items: center;
    background: var(--surface);
  }
  .product-section.alt .product-figure { background: var(--paper); }
  .product-figure img { max-width: 100%; height: auto; }

  @media (min-width: 1024px) {
    .product-layout { grid-template-columns: 1.15fr 0.85fr; gap: 3.5rem; }
  }
</style>

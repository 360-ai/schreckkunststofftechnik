---
import BaseLayout from '@layouts/BaseLayout.astro';
import { company, seo } from '@data/site';
---

<BaseLayout
  title={seo.kontakt.title}
  description={seo.kontakt.description}
  breadcrumbs={[{ name: 'Kontakt', href: '/kontakt/' }]}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Kontakt</p>
      <h1 class="section-heading">So erreichen Sie SKT</h1>
      <p class="page-intro">
        Für Projektanfragen mit Zeichnung oder CAD-Daten nutzen Sie am besten das
        <a href="/#anfrage">Anfrage-Formular auf der Startseite</a>. Für alles andere: anrufen oder schreiben.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-layout">
        <figure class="card contact-photo reveal">
          <img
            src="/images/kontakt-buero.webp"
            alt="Arbeitsplatz im Büro von SKT in Burgwald-Bottendorf"
            width="1200"
            height="900"
            loading="lazy"
          />
        </figure>

        <ul class="contact-grid">
          <li class="card contact-card reveal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 5c0-1 .8-2 1.9-2h2.3c.9 0 1.6.6 1.9 1.4l.9 2.8c.2.8 0 1.6-.7 2.1l-1.2 1a13.5 13.5 0 0 0 5.6 5.6l1-1.2c.5-.7 1.3-.9 2.1-.7l2.8.9c.8.3 1.4 1 1.4 1.9v2.3c0 1.1-1 1.9-2 1.9C10.6 21 3 13.4 4 5Z"/></svg>
            <h2>Telefon</h2>
            <a href={company.phoneLink} class="contact-link">{company.phoneDisplay}</a>
          </li>
          <li class="card contact-card reveal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <h2>E-Mail</h2>
            <a href={`mailto:${company.email}`} class="contact-link contact-mail">{company.email}</a>
          </li>
          <li class="card contact-card reveal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 3h10v6H7z"/><path d="M7 21h10v-6H7z"/><path d="M5 9h14a1 1 0 0 1 1 1v5h-3M4 15H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1"/></svg>
            <h2>Fax</h2>
            <p class="contact-static">{company.faxDisplay}</p>
          </li>
          <li class="card contact-card reveal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <h2>Adresse</h2>
            <p class="contact-static">
              {company.street}<br />
              {company.zip} {company.city}
            </p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section anfahrt-section" id="anfahrt">
    <div class="container anfahrt-layout">
      <div>
        <p class="eyebrow">Anfahrt</p>
        <h2 class="section-heading">Standort Burgwald-Bottendorf</h2>
        <p class="anfahrt-text">
          SKT sitzt in der {company.street} in {company.zip} {company.city}, Nordhessen.
          Die Route öffnet sich erst nach Ihrem Klick bei Google Maps; vorher lädt diese Seite nichts von Google.
        </p>
        <a href={company.mapsLink} class="btn btn-primary" rel="noopener" target="_blank">
          Route in Google Maps öffnen
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 17 17 7m0 0H9m8 0v8"/></svg>
        </a>
      </div>
      <figure class="card img-card reveal">
        <img src="/images/luftbild-skt.webp" alt="Luftaufnahme des SKT-Standorts in Burgwald-Bottendorf" width="1451" height="1084" loading="lazy" />
      </figure>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: var(--surface);
    border-bottom: 1px solid rgba(38, 142, 166, 0.15);
    padding-block: 2.75rem 2rem;
  }
  .page-intro { color: var(--slate); margin-top: 0.875rem; max-width: 60ch; }
  .page-intro a { color: var(--petrol-deep); }

  .contact-layout { display: grid; gap: 1.25rem; }
  .contact-photo {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .contact-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .contact-grid { display: grid; gap: 1.25rem; }
  .contact-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem;
  }
  .contact-card svg { width: 1.75rem; height: 1.75rem; color: var(--petrol); }
  .contact-card h2 { font-size: 1.0625rem; margin-top: 0.75rem; }
  .contact-link {
    align-self: flex-start;
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--petrol-deep);
    text-decoration: none;
  }
  .contact-mail { overflow-wrap: anywhere; font-size: 1rem; }
  .contact-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .contact-static { color: var(--slate); margin-top: 0.375rem; }

  .anfahrt-section { background: var(--surface); }
  .anfahrt-layout { display: grid; gap: 2rem; align-items: center; }
  .anfahrt-text { color: var(--slate); margin-top: 1rem; margin-bottom: 1.5rem; }
  .img-card { overflow: hidden; }
  .img-card img { width: 100%; height: auto; display: block; }

  @media (min-width: 640px) {
    .contact-grid { grid-template-columns: 1fr 1fr; }
    .contact-photo { aspect-ratio: 16 / 9; }
  }
  @media (min-width: 1024px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      align-items: stretch;
      gap: 1.5rem;
    }
    .contact-photo { aspect-ratio: 3 / 2; }
    .contact-grid { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 1.5rem; }
    .anfahrt-layout { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }
</style>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import { company } from '@data/site';
---

<BaseLayout
  title="Seite nicht gefunden | Schreck Kunststofftechnik GmbH"
  description="Die angeforderte Seite existiert nicht. Zur Startseite der Schreck Kunststofftechnik GmbH."
  robots="noindex, follow"
>
  <section class="section">
    <div class="container notfound">
      <p class="eyebrow">Fehler 404</p>
      <h1 class="section-heading">Diese Seite gibt es nicht</h1>
      <p>
        Die Adresse ist veraltet oder vertippt. Sie finden alle Inhalte über die Startseite, oder Sie rufen uns an:
        <a href={company.phoneLink}>{company.phoneDisplay}</a>.
      </p>
      <div class="notfound-actions">
        <a href="/" class="btn btn-primary">Zur Startseite</a>
        <a href="/produkte/" class="btn btn-outline">Zu den Produkten</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound { max-width: 44rem; }
  .notfound p { color: var(--slate); margin-top: 1rem; }
  .notfound a:not(.btn) { color: var(--petrol-deep); }
  .notfound-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
</style>

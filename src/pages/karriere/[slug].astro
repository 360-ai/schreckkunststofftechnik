---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import { company } from "@data/site";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const jobs = (await getCollection("jobs")).filter((job) => job.data.active);

  return jobs.map((job) => ({
    params: { slug: job.id.replace(/\.mdx?$/, "") },
    props: { job }
  }));
}

const { job } = Astro.props;
const { Content } = await render(job);
const canonicalUrl = new URL(`/karriere/${job.id.replace(/\.mdx?$/, "")}/`, Astro.site).toString();
const plainDescription = job.body
  .replace(/^#+\s+/gm, "")
  .replace(/^- /gm, "")
  .replace(/\s+/g, " ")
  .trim();

const jobSchema = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  "@id": `${canonicalUrl}#jobposting`,
  title: job.data.title,
  description: plainDescription,
  datePosted: job.data.datePosted,
  validThrough: job.data.validThrough,
  employmentType: job.data.type === "Ausbildung" ? "INTERN" : "FULL_TIME",
  directApply: false,
  identifier: {
    "@type": "PropertyValue",
    name: company.name,
    value: job.id.replace(/\.mdx?$/, "")
  },
  hiringOrganization: {
    "@id": new URL("/#organization", Astro.site).toString()
  },
  jobLocation: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      streetAddress: company.street,
      postalCode: company.postalCode,
      addressLocality: company.locality,
      addressRegion: company.region,
      addressCountry: company.country
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Startseite",
      item: new URL("/", Astro.site).toString()
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Karriere",
      item: new URL("/karriere/", Astro.site).toString()
    },
    {
      "@type": "ListItem",
      position: 3,
      name: job.data.title,
      item: canonicalUrl
    }
  ]
};
---

<BaseLayout
  title={job.data.title}
  description={`Stellenanzeige bei ${company.name}: ${job.data.title} in ${job.data.location}, Start ${job.data.start}.`}
  image="/images/team.jpg"
  canonical={canonicalUrl}
  jsonLd={[jobSchema, breadcrumbSchema]}
>
  <PageHero
    eyebrow={job.data.type}
    title={job.data.title}
    text={`Start ${job.data.start} in ${job.data.location}. Bewirb dich direkt bei ${company.name}.`}
    image="/images/team.jpg"
    parent={{ label: "Karriere", href: "/karriere/" }}
  />

  <section class="section">
    <div class="container job-detail">
      <aside class="job-summary card">
        <div class="card-body">
          <p class="eyebrow">Stellendaten</p>
          <dl>
            <div><dt>Start</dt><dd>{job.data.start}</dd></div>
            <div><dt>Standort</dt><dd>{job.data.location}</dd></div>
            <div><dt>Bereich</dt><dd>{job.data.type}</dd></div>
          </dl>
          <a class="button" href={`mailto:${job.data.applyEmail}?subject=Bewerbung: ${job.data.title}`}>Jetzt bewerben</a>
        </div>
      </aside>
      <article class="content job-copy">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .job-detail {
    display: grid;
    grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
    gap: 42px;
    align-items: start;
  }

  .job-summary {
    position: sticky;
    top: 110px;
  }

  dl {
    display: grid;
    gap: 14px;
    margin: 20px 0 24px;
  }

  dt {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  dd {
    margin: 4px 0 0;
    color: var(--primary-deep);
    font-weight: 800;
  }

  .job-copy {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: clamp(24px, 4vw, 42px);
    background: #fff;
    box-shadow: 0 18px 44px rgba(12, 18, 32, 0.06);
  }

  @media (max-width: 820px) {
    .job-detail {
      grid-template-columns: 1fr;
    }

    .job-summary {
      position: static;
    }
  }
</style>

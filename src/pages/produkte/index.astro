---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import ProductCard from "@components/ProductCard.astro";
import { products } from "@data/site";

const faqs = [
  {
    q: "Welche Produktbereiche deckt Schreck Kunststofftechnik ab?",
    a: "Schreck fertigt Spritzgusswerkzeuge für sechs Schwerpunktbereiche: Medizintechnik, Labortechnik, Verpackung und Kosmetik, Innenanspritzung, Mehrkomponentenwerkzeuge sowie Kleinstteile."
  },
  {
    q: "Fertigt Schreck auch Werkzeuge für regulierte Branchen wie Medizintechnik?",
    a: "Ja. Für Medizintechnik und Labortechnik entwickelt Schreck Werkzeuge mit reproduzierbarer Qualität, sauberen Oberflächen, Partikelfreiheit und vollständiger Qualitätsdokumentation — abgestimmt auf die besonderen Anforderungen regulierter Anwendungen."
  },
  {
    q: "Was sind Mehrkomponentenwerkzeuge?",
    a: "Mehrkomponentenwerkzeuge — auch 2K-Werkzeuge genannt — ermöglichen das Spritzgießen von Bauteilen aus mehreren Materialien oder Farben in einem Prozessschritt. Schreck entwickelt diese Werkzeuge mit Voll- und Teilheißkanallösungen für reproduzierbare Serienqualität."
  },
  {
    q: "Für welche Kleinteile kann Schreck Werkzeuge bauen?",
    a: "Schreck fertigt Kleinstartikelformen für funktionale Kleinstteile, optische Gehäuse und technische Bauteile mit hohen Anforderungen an Entlüftung, Maßhaltigkeit und Standzeit — unter anderem für Medizintechnik und Elektronik."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a }
  }))
};
---

<BaseLayout
  title="Produkte und Werkzeugbau"
  description="Produktbereiche von Schreck Kunststofftechnik: Medizintechnik, Labortechnik, Verpackung, Innenanspritzung, Mehrkomponentenwerkzeuge und Kleinstteile."
  jsonLd={faqSchema}
>
  <PageHero eyebrow="Produkte" title="Formtechnologie für hohe Wertschöpfung" text="Schreck entwickelt und fertigt Formen für Kunststoff-, Aluminium- und Zink-Druckgussverarbeitung. Die Umsetzung erfolgt nach Kundenvorgaben von der Idee bis zur Serienreife." />
  <section class="section">
    <div class="container">
      <div class="grid three">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>
  <section class="section soft">
    <div class="container">
      <p class="eyebrow">Häufige Fragen</p>
      <h2>Fragen zu den Produktbereichen</h2>
      <div class="faq-list">
        {faqs.map(({ q, a }) => (
          <details class="faq-item">
            <summary>{q}</summary>
            <div class="faq-answer">{a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
